const totalTasks = plan.reduce((n, w) => n + w.days.reduce((m, d) => m + d.tasks.length, 0), 0);
const totalDays = plan.reduce((n, w) => n + w.days.length, 0);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Go Backend in 30 Days: Interactive Plan</title>
    <meta
      name="description"
      content="A 4-week interactive plan to learn Go for backend engineering: HTTP APIs, notifications, Kafka, Snowflake and Databricks."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="hero">
      <div class="hero-inner">
        <p class="eyebrow">4 weeks · {totalDays} days · {totalTasks} checkable tasks</p>
        <h1>Learn <span class="go">Go</span> for Backend in One Month</h1>
        <p class="subtitle">
          From zero to a production-shaped backend: HTTP APIs, notification systems, Kafka pipelines, and data platforms
          (Snowflake & Databricks). Progress is saved in your browser.
        </p>
        <div class="overall" aria-label="Overall progress">
          <div class="overall-bar"><div class="overall-fill" id="overall-fill"></div></div>
          <span class="overall-label" id="overall-label">0%</span>
        </div>
      </div>
    </header>

    <nav class="tabs" id="tabs" aria-label="Weeks">
      {plan.map((week, wi) => (
        <button class="tab" data-tab={wi} type="button">
          <span class="tab-name">{week.name}</span>
          <span class="tab-theme">{week.theme}</span>
          <span class="tab-progress" data-week-progress={wi}>0%</span>
        </button>
      ))}
    </nav>

    <main id="main">
      {plan.map((week, wi) => (
        <section class="week-panel" data-panel={wi} hidden={wi !== 0}>
          <div class="week-head">
            <h2>{week.name} · {week.theme}</h2>
            <p class="blurb">{week.blurb}</p>
          </div>

          <div class="days">
            {week.days.map((day, di) => (
              <article class="day" data-day={`${wi}-${di}`}>
                <div class="day-head">
                  <span class="day-num">Day {wi * 7 + di + 1}</span>
                  <h3>{day.title}</h3>
                  <span class="day-done-badge" data-day-badge={`${wi}-${di}`} hidden>✓ done</span>
                </div>
                <p class="goal"><strong>Goal:</strong> {day.goal}</p>
                <div class="chips">
                  {day.topics.map((t) => <span class="chip">{t}</span>)}
                </div>
                <div class="exercise">
                  <span class="exercise-label">Hands-on</span>
                  <p>{day.exercise}</p>
                </div>
                <ul class="tasks">
                  {day.tasks.map((task, ti) => (
                    <li>
                      <label class="task">
                        <input type="checkbox" data-task={`${wi}-${di}-${ti}`} />
                        <span>{task}</span>
                      </label>
                    </li>
                  ))}
                </ul>
                <div class="resources">
                  {day.resources.map((r) => (
                    <a class="resource" href={r.url} target="_blank" rel="noopener noreferrer">{r.label} ↗</a>
                  ))}
                </div>
              </article>
            ))}
          </div>

          <div class="quiz">
            <button class="quiz-toggle" data-quiz-toggle={wi} type="button" aria-expanded="false">
              <span>{week.name} quiz: {week.quiz.length} questions</span>
              <span class="quiz-score" data-quiz-score={wi}></span>
            </button>
            <div class="quiz-body" data-quiz-body={wi} hidden>
              {week.quiz.map((q, qi) => (
                <fieldset class="question" data-question={`${wi}-${qi}`} data-answer={q.answer}>
                  <legend>{qi + 1}. {q.q}</legend>
                  <div class="options">
                    {q.options.map((opt, oi) => (
                      <button class="option" type="button" data-opt={`${wi}-${qi}-${oi}`}>{opt}</button>
                    ))}
                  </div>
                </fieldset>
              ))}
              <div class="quiz-actions">
                <button class="btn btn-primary" data-quiz-check={wi} type="button">Check answers</button>
                <button class="btn" data-quiz-retry={wi} type="button">Retry</button>
              </div>
              <p class="quiz-result" data-quiz-result={wi}></p>
            </div>
          </div>

          <div class="week-nav">
            <button class="btn" data-nav={wi - 1} type="button" disabled={wi === 0}>← Previous week</button>
            <button class="btn" data-nav={wi + 1} type="button" disabled={wi === plan.length - 1}>Next week →</button>
          </div>
        </section>
      ))}
    </main>

    <footer>
      <p>Tip: check off tasks as you go. Everything is saved locally in this browser.</p>
      <button class="btn btn-danger" id="reset" type="button">Reset all progress</button>
    </footer>

    <script>
      const STORAGE_KEY = 'go-backend-plan-v1';

      function loadState() {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') || {};
        } catch {
          return {};
        }
      }
      const state = loadState();
      state.tasks ||= {};
      state.quiz ||= {};
      state.currentWeek ??= 0;

      function save() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      }

      function taskKey(dayEl, input) {
        return input.dataset.task;
      }

      // ---- Progress ----
      const dayEls = Array.from(document.querySelectorAll('[data-day]'));
      const overallFill = document.getElementById('overall-fill');
      const overallLabel = document.getElementById('overall-label');
      const tabProgressEls = Object.fromEntries(
        Array.from(document.querySelectorAll('[data-week-progress]')).map((el) => [el.dataset.weekProgress, el])
      );
      const dayBadges = Object.fromEntries(
        Array.from(document.querySelectorAll('[data-day-badge]')).map((el) => [el.dataset.dayBadge, el])
      );

      function refreshProgress() {
        let doneTotal = 0;
        let total = 0;
        const weekTotals = {};
        for (const dayEl of dayEls) {
          const inputs = Array.from(dayEl.querySelectorAll('input[type="checkbox"]'));
          const done = inputs.filter((i) => i.checked).length;
          const [wi] = dayEl.dataset.day.split('-');
          weekTotals[wi] ||= { done: 0, total: 0 };
          weekTotals[wi].done += done;
          weekTotals[wi].total += inputs.length;
          doneTotal += done;
          total += inputs.length;
          const complete = inputs.length > 0 && done === inputs.length;
          dayEl.classList.toggle('complete', complete);
          const badge = dayBadges[dayEl.dataset.day];
          if (badge) badge.hidden = !complete;
        }
        for (const [wi, el] of Object.entries(tabProgressEls)) {
          const w = weekTotals[wi] || { done: 0, total: 1 };
          el.textContent = w.total ? `${Math.round((w.done / w.total) * 100)}%` : '0%';
        }
        const pct = total ? Math.round((doneTotal / total) * 100) : 0;
        overallFill.style.transform = `scaleX(${pct / 100})`;
        overallLabel.textContent = pct + '%';
      }

      document.querySelectorAll('input[type="checkbox"][data-task]').forEach((input) => {
        if (state.tasks[taskKey(input.closest('[data-day]'), input)]) input.checked = true;
        input.addEventListener('change', () => {
          state.tasks[input.dataset.task] = input.checked;
          if (!input.checked) delete state.tasks[input.dataset.task];
          save();
          refreshProgress();
        });
      });
      refreshProgress();

      // ---- Week tabs & navigation ----
      const panels = Array.from(document.querySelectorAll('[data-panel]'));
      const tabs = Array.from(document.querySelectorAll('.tab'));

      let switching = false;
      function showWeek(wi) {
        if (switching) return;
        switching = true;
        state.currentWeek = wi;
        save();
        // isolate layout thrash: hide all, then show one in next frame
        panels.forEach((p) => (p.hidden = Number(p.dataset.panel) !== wi));
        tabs.forEach((t) => t.classList.toggle('active', Number(t.dataset.tab) === wi));
        const activePanel = panels[wi];
        if (activePanel) {
          activePanel.style.animation = 'none';
          void activePanel.offsetHeight;
          activePanel.style.animation = '';
        }
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const nearTop = window.scrollY < 80;
        if (!nearTop) window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        // release lock after panel animation + scroll settle
        setTimeout(() => { switching = false; }, 260);
      }

      // sticky tabs hairline + cross-platform helper
      const tabsEl = document.getElementById('tabs');
      if (tabsEl && 'IntersectionObserver' in window) {
        const sentinel = document.createElement('div');
        sentinel.setAttribute('aria-hidden', 'true');
        sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px;pointer-events:none;';
        document.body.prepend(sentinel);
        new IntersectionObserver(([e]) => tabsEl.classList.toggle('is-stuck', !e.isIntersecting), { threshold: 0 }).observe(sentinel);
      }
      tabs.forEach((t) => t.addEventListener('click', () => showWeek(Number(t.dataset.tab))));
      document.querySelectorAll('[data-nav]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const target = Number(btn.dataset.nav);
          if (target >= 0 && target < panels.length) showWeek(target);
        })
      );
      showWeek(Number(state.currentWeek) || 0);

      // ---- Quizzes ----
      for (let wi = 0; wi < panels.length; wi++) {
        const toggle = document.querySelector(`[data-quiz-toggle="${wi}"]`);
        const body = document.querySelector(`[data-quiz-body="${wi}"]`);
        const scoreBadge = document.querySelector(`[data-quiz-score="${wi}"]`);
        const resultEl = document.querySelector(`[data-quiz-result="${wi}"]`);
        const checkBtn = body.querySelector(`[data-quiz-check="${wi}"]`);
        const retryBtn = body.querySelector(`[data-quiz-retry="${wi}"]`);
        const questions = Array.from(body.querySelectorAll('[data-question]'));

        toggle.addEventListener('click', () => {
          const open = body.hidden;
          body.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
        });

        function clearMarks() {
          questions.forEach((q) => {
            q.classList.remove('correct', 'incorrect');
            q.querySelectorAll('.option').forEach((o) => o.classList.remove('selected', 'right', 'wrong'));
          });
          resultEl.textContent = '';
        }

        function restore() {
          const saved = state.quiz[wi];
          clearMarks();
          if (!saved || !Array.isArray(saved.answers)) return;
          saved.answers.forEach((sel, qi) => {
            if (sel == null) return;
            const opt = body.querySelector(`[data-opt="${wi}-${qi}-${sel}"]`);
            if (opt) opt.classList.add('selected');
          });
          if (saved.done) grade();
        }

        function grade() {
          const answers = questions.map((q) => {
            const sel = q.querySelector('.option.selected');
            return sel ? Number(sel.dataset.opt.split('-')[2]) : null;
          });
          let correct = 0;
          questions.forEach((q, qi) => {
            const right = Number(q.dataset.answer);
            const sel = answers[qi];
            q.querySelectorAll('.option').forEach((o) => {
              const oi = Number(o.dataset.opt.split('-')[2]);
              if (oi === right) o.classList.add('right');
              if (sel != null && oi === sel && sel !== right) o.classList.add('wrong');
            });
            q.classList.add(sel === right ? 'correct' : 'incorrect');
            if (sel === right) correct++;
          });
          const pct = Math.round((correct / questions.length) * 100);
          resultEl.textContent = `You scored ${correct}/${questions.length} (${pct}%).` +
            (pct === 100 ? ' Perfect. Move on! 🎉' : pct >= 60 ? ' Solid. Review the misses above.' : ' Revisit this week’s days, then retry.');
          scoreBadge.textContent = `${correct}/${questions.length}`;
          state.quiz[wi] = { answers, done: true, score: correct };
          save();
        }

        body.querySelectorAll('.option').forEach((opt) =>
          opt.addEventListener('click', () => {
            const [, qiStr] = opt.dataset.opt.split('-');
            const q = body.querySelector(`[data-question="${wi}-${qiStr}"]`);
            q.querySelectorAll('.option').forEach((o) => o.classList.remove('selected'));
            opt.classList.add('selected');
          })
        );
        checkBtn.addEventListener('click', grade);
        retryBtn.addEventListener('click', () => {
          delete state.quiz[wi];
          scoreBadge.textContent = '';
          save();
          clearMarks();
          body.querySelectorAll('.option').forEach((o) => o.classList.remove('selected'));
        });

        restore();
      }

      // ---- Reset ----
      document.getElementById('reset').addEventListener('click', () => {
        if (!confirm('Reset all progress and quiz results?')) return;
        localStorage.removeItem(STORAGE_KEY);
        location.reload();
      });
    </script>
  </body>
</html>

<style>
  /* Supermemory-editorial · YC calm · full-bleed · Geist fluid scale · unified interaction */
  :root {
    --bg: #ffffff;
    --surface: #f8f8f7;
    --line: rgba(17, 17, 17, 0.08);
    --line-strong: rgba(17, 17, 17, 0.13);
    --text: #111111;
    --text-soft: #2a2a2a;
    --muted: #6b6b6b;
    --faint: #9a9a96;
    --accent: #111111;
    --accent-hover: #1f1f1f;
    --green: #1a7f37;
    --green-soft: #f0f6f2;
    --green-border: #c8ddd2;
    --red: #9b3a2e;
    --red-soft: #fdf2f0;
    --red-border: #e8c4bf;
    --radius-card: 10px;
    --radius-inner: 6px;
    --radius-pill: 999px;
    --ease: 180ms cubic-bezier(0.4, 0, 0.2, 1);
    --ease-out: 220ms cubic-bezier(0.16, 1, 0.3, 1);
    --font: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --mono: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 16px;
    -webkit-text-size-adjust: 100%;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
    overflow-y: scroll;
  }
  html:focus-within { scroll-behavior: smooth; }
  /* prevent scroll chaining bounce that reads as shift */
  body { overscroll-behavior-y: none; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: clamp(14px, 0.95vw + 11px, 15px);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
    -webkit-tap-highlight-color: transparent;
  }
  ::selection { background: #111; color: #fff; }

  /* ---- Font hierarchy: fluid, distinct per heading level ---- */
  h1 {
    margin: 0 0 12px;
    font-family: var(--font);
    font-size: clamp(28px, 4vw + 12px, 42px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--text);
  }
  .week-head h2 {
    margin: 0 0 6px;
    font-family: var(--font);
    font-size: clamp(18px, 1.6vw + 12px, 22px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.25;
    color: var(--text);
  }
  .day h3 {
    margin: 0;
    font-family: var(--font);
    font-size: clamp(14px, 0.6vw + 12px, 15.5px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
    color: var(--text);
  }
  .question legend {
    font-family: var(--font);
    font-weight: 600;
    font-size: 13.5px;
    letter-spacing: -0.01em;
    line-height: 1.4;
    padding: 0 4px;
  }

  /* ---- Header: full-bleed edge-to-edge ---- */
  .hero {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding: clamp(32px, 5vw, 56px) clamp(16px, 4vw, 40px) clamp(20px, 3vw, 28px);
    width: 100%;
  }
  .hero-inner {
    max-width: none;
    width: 100%;
    margin: 0;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: clamp(10px, 0.4vw + 9px, 11px);
    font-weight: 400;
    color: var(--faint);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .go { font-weight: 600; color: var(--text); letter-spacing: -0.02em; }
  .subtitle {
    color: var(--muted);
    max-width: 560px;
    margin: 0 0 22px;
    font-size: clamp(14px, 0.6vw + 12px, 15px);
    line-height: 1.6;
    font-weight: 400;
  }
  .overall { display: flex; align-items: center; gap: 12px; max-width: 640px; }
  .overall-bar {
    flex: 1;
    height: 2px;
    background: var(--line);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  .overall-fill {
    height: 100%;
    width: 100%;
    background: var(--accent);
    border-radius: var(--radius-pill);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
    transition: transform 420ms var(--ease-out);
  }
  .overall-label {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 11px;
    min-width: 36px;
    color: var(--faint);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  /* ---- Week tabs: full-bleed, sticky, cross-platform scroll ---- */
  .tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    max-width: none;
    width: 100%;
    margin: 0;
    padding: 14px clamp(16px, 4vw, 40px) 0;
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px) saturate(180%);
    -webkit-backdrop-filter: blur(10px) saturate(180%);
    border-bottom: 1px solid transparent;
    transform: translateZ(0);
    contain: paint;
    overscroll-behavior-x: contain;
  }
  .tabs.is-stuck { border-bottom-color: var(--line); }
  @media (max-width: 900px) {
    .tabs {
      grid-template-columns: none;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
      padding-bottom: 12px;
    }
    .tabs::-webkit-scrollbar { display: none; }
    .tab { flex: 0 0 68%; min-width: 220px; }
  }
  @media (max-width: 520px) { .tab { flex-basis: 82%; } }
  .tab {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-inner);
    color: var(--text);
    padding: 12px 14px 11px;
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font);
    transition: background var(--ease), border-color var(--ease), color var(--ease);
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  .tab:hover { background: var(--surface); border-color: var(--line); }
  .tab:active { background: color-mix(in srgb, var(--surface) 85%, var(--line) 15%); }
  .tab:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }
  .tab.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }
